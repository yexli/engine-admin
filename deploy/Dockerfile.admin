# ============================================================
# Admin Web（生产构建 + Nginx 同源反代）
# ------------------------------------------------------------
# 构建上下文 = 仓库根。两阶段：node 编译产物 → nginx 托管；
# nginx 模板（admin-web/nginx.conf.template）由 nginx 官方镜像在启动时
# envsubst 实例化，环境变量见 deploy/docker-compose.yml。
# TLS：在负载均衡/入口层终结，或把模板 listen 80 改为 443 ssl 并挂证书。
# ============================================================
FROM node:22-alpine AS build
RUN corepack enable && npm i -g pnpm@11
WORKDIR /app
COPY admin-web/package.json admin-web/pnpm-lock.yaml* ./
RUN pnpm install --no-frozen-lockfile
COPY admin-web/ ./
# 直调 vite（Windows cmd 下 `NODE_OPTIONS=x vite` env 前缀不可用的项目已知问题）
RUN NODE_OPTIONS=--max-old-space-size=8192 ./node_modules/.bin/vite build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY admin-web/nginx.conf.template /etc/nginx/templates/default.conf.template

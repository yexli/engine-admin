# 平台本地运行端口号
VITE_PORT = 8848

# 是否隐藏首页 隐藏 true 不隐藏 false （勿删除，VITE_HIDE_HOME只需在.env文件配置）
VITE_HIDE_HOME = false

# ---------- World Driving Engine 后端地址（vite 代理目标） ----------
# World Engine HTTP API（world-engine startWorldServer，默认 127.0.0.1:8787）
VITE_WORLD_API_URL = http://127.0.0.1:8787
# AI Gateway HTTP API（gateway server，默认 127.0.0.1:8788）
VITE_GATEWAY_API_URL = http://127.0.0.1:8788

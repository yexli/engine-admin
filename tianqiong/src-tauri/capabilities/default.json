{
  "identifier": "default",
  "description": "主窗口能力：核心 + SQLite 存档读写",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-load",
    {
      "identifier": "sql:allow-execute",
      "allow": [{ "url": "sqlite:tianqiong.db" }]
    },
    {
      "identifier": "sql:allow-select",
      "allow": [{ "url": "sqlite:tianqiong.db" }]
    },
    "sql:allow-close"
  ]
}

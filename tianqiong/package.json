{
  "name": "tianqiong",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "天穹纪元 2.0 —— World Engine 的外部游戏客户端（React + TypeScript + Vite；世界裁定在会话宿主 server/game-host，客户端纯表现）",
  "scripts": {
    "dev": "vite",
    "host:world": "node scripts/world-host.mjs",
    "host:http": "node scripts/http-host.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "tauri": "tauri",
    "build:game": "vite build -c vite.game-host.config.ts",
    "host:game": "npm run build:game && node .server-build/game-host.mjs"
  },
  "dependencies": {
    "@fontsource/noto-serif-sc": "^5.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-sql": "^2.4.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "world-engine": "file:..\\world-engine",
    "zustand": "^5.0.15",
    "world-gateway": "link:../world-engine/gateway"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
